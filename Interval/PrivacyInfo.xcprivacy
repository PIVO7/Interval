<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Roundly does not perform tracking as Apple defines it: no
         third-party advertising SDKs, no cross-site/app linking of user
         identity for advertising or measurement. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- No data collected. Favorites sync through the user's own private
         iCloud database, which the developer cannot read; there are no
         accounts, analytics or servers of our own. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- Required-reason API declarations. These are Apple-defined "tracked"
         APIs that ALL apps using them must declare with an approved reason. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults: read/write app-only settings (audio prefs,
             hasSeenOnboarding). Reason CA92.1:
             "Access info from same app". -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
